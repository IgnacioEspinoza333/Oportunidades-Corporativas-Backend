<?xml version="1.0" encoding="utf-8"?>
<!--
    Android bloquea por defecto las conexiones http (sin cifrar).
    Nuestro backend corre en el computador sin HTTPS, así que lo permitimos.
    Es válido para un proyecto académico; en producción se usaría HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>